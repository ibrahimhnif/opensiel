# Copy to .env for local development.
# Generate the master key with: openssl rand -base64 32
DATABASE_URL=postgres://opensiel:opensiel@localhost:5432/opensiel
OPENSIEL_MASTER_KEY=replace-with-32-byte-base64-key
OPENSIEL_JWT_SECRET=replace-with-at-least-32-random-characters
OPENSIEL_PUBLIC_URL=http://localhost:8787
OPENSIEL_ALLOW_SIGNUP=true
# OPENSIEL_WEB_DIR=apps/web/dist
# PORT=8787

# OIDC SSO (optional; all three required to enable)
# OPENSIEL_OIDC_ISSUER=https://accounts.google.com
# OPENSIEL_OIDC_CLIENT_ID=
# OPENSIEL_OIDC_CLIENT_SECRET=
# OPENSIEL_OIDC_REDIRECT_URI=https://opensiel.example.com/api/auth/oidc/callback
# OPENSIEL_OIDC_ALLOWED_DOMAINS=example.com
# OPENSIEL_OIDC_AUTO_CREATE=true

# SAML SSO (optional; entry point + IdP certificate are required)
# OPENSIEL_SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# OPENSIEL_SAML_ISSUER=https://opensiel.example.com
# OPENSIEL_SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# OPENSIEL_SAML_CALLBACK_URL=https://opensiel.example.com/api/auth/saml/callback
# OPENSIEL_SAML_ALLOWED_DOMAINS=example.com
# OPENSIEL_SAML_AUTO_CREATE=true

# External KMS (replaces OPENSIEL_MASTER_KEY when set)
# OPENSIEL_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# OPENSIEL_KMS_WRAPPED_MASTER_KEY=<base64 ciphertext blob from aws kms encrypt>
# OPENSIEL_KMS_REGION=us-east-1
# OPENSIEL_KMS_ENDPOINT=
# OPENSIEL_KMS_ACCESS_KEY_ID=
# OPENSIEL_KMS_SECRET_ACCESS_KEY=
