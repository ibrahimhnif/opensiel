# Copy to .env for local development.
# Generate the master key with: openssl rand -base64 32
DATABASE_URL=postgres://opensiel:opensiel@localhost:5432/opensiel
OPENSIEL_MASTER_KEY=replace-with-32-byte-base64-key
OPENSIEL_JWT_SECRET=replace-with-at-least-32-random-characters
OPENSIEL_PUBLIC_URL=http://localhost:8787
OPENSIEL_ALLOW_SIGNUP=true
# OPENSIEL_WEB_DIR=apps/web/dist
# PORT=8787
